{
  "name": "workspace-mcp",
  "version": "0.4.1",
  "description": "Self-hosted portable workspace for AI agents, served as a remote MCP server.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "cli": "node src/cli.ts",
    "dev": "node --watch src/main.ts",
    "build:ui": "vite build -c ui/vite.config.ts",
    "dev:ui": "vite -c ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.28",
    "@better-auth/kysely-adapter": "^1.7.28",
    "@better-auth/mcp": "^1.7.28",
    "@better-auth/oauth-provider": "^1.7.28",
    "@better-auth/passkey": "^1.7.28",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "^1.7.28",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.22",
    "ipaddr.js": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@simplewebauthn/browser": "^13.3.0",
    "@types/node": "^26.6.10",
    "preact": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
