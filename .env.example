# Public https address of the service, without a path. Agents and passkeys are bound to it.
PUBLIC_URL=https://workspace.example.com

# 32 random bytes in base64: openssl rand -base64 32
# Signs sessions and encrypts the stored GitHub token and webhook secrets. Keep it secret and back it up; changing it signs everyone out
# and makes stored GitHub and webhook secrets unreadable.
SECRET_KEY=

# true: the service is reached through a reverse proxy or tunnel (the usual setup; compose binds the port to 127.0.0.1 only,
# so clients cannot bypass it). Set it to false when clients connect to the port directly, for example a local trial on localhost.
TRUST_PROXY=true

# Port on 127.0.0.1 that compose publishes (default 8080). For a local trial, PUBLIC_URL must use the same port.
# HOST_PORT=8080

# Optional settings (defaults shown). Every setting is described in docs/configuration.md.
# LOG_LEVEL=info
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# GITHUB_SYNC_INTERVAL_MINUTES=15
# ACCESS_TOKEN_TTL_SECONDS=3600
# UNUSED_CLIENT_TTL_DAYS=7
# Where users can get the source of what you run (AGPL). Change it only if you deploy modified code.
# SOURCE_URL=https://github.com/viktorermolov/workspace-mcp

# Only for the optional cloudflared service in compose.yaml.
# CLOUDFLARED_TOKEN=
